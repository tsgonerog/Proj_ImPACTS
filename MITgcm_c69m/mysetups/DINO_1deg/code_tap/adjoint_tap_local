#!/bin/bash
# Tapenade options for this setup. genmake2 sources this file
# (-adof=../code_tap/adjoint_tap_local) with ROOTDIR set.
#
# The stock file supplies Tapenade's external library,
# tools/TAP_support/flow_tap, and the differentiation head. This file sources
# it and then appends the setup's own library, code_tap/flow_tap_local, which
# re-declares the four hooks that flow_tap declares all-passive
# (dummy_in_stepping, dummy_for_etan, autodiff_inadmode_set and
# autodiff_inadmode_unset)
# with their field arguments active, so that Tapenade generates the
# reverse-sweep calls to their hand-written _B bodies (code_tap/dummy_tap.F).
#
# The order is load-bearing: Tapenade keeps the LAST declaration of an
# external. Passed first, through -tap_extra, the local stanza lost to the
# stock one ("TC32 Conflicting numbers of arguments", tested 2026-09-02) and
# no _B call was generated. The -ext path is relative to the build directory,
# like -mods.
. "$ROOTDIR/tools/adjoint_options/adjoint_tap"
TAPENADE_FLAGS="$TAPENADE_FLAGS -ext ../code_tap/flow_tap_local"
