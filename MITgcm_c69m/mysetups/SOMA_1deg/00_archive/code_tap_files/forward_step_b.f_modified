      CALL POPREAL8ARRAY(qsw0, (snx+2*olx)*(sny+2*oly)*nsx*nsy)
      CALL POPREAL8ARRAY(qsw1, (snx+2*olx)*(sny+2*oly)*nsx*nsy)
      CALL POPREAL8ARRAY(pload0, (snx+2*olx)*(sny+2*oly)*nsx*nsy)
      CALL POPREAL8ARRAY(pload1, (snx+2*olx)*(sny+2*oly)*nsx*nsy)
      CALL LOAD_FIELDS_DRIVER_B(mytime, myiter, mythid)
      CALL POPCONTROL1B(branch)
      IF (branch .EQ. 0) THEN
        CALL UPDATE_R_STAR_B(.false., mytime, myiter, mythid)
      ELSE
        CALL UPDATE_SURF_DR_B(.false., mytime, myiter, mythid)
      END IF
      CALL RESET_NLFS_VARS_B(mytime, myiter, mythid)
      END

