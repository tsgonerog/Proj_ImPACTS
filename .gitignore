# Claude Code local settings (permissions etc.) - machine-specific
.claude/settings.local.json

# Match any directory named exactly 'build' at any depth
**/build/

# Match any directory that starts with 'build' (e.g., build_test, build_upd)
**/build*/

# Ignore all Jupyter Notebook checkpoints directory an any depth
**/.ipynb_checkpoints/

# Ignore large input binaries
MITgcm_c69m/mysetups/SOMA_1deg/input_binaries
MITgcm_c69m/mysetups/SOMA_1deg/input_adj_binaries/
MITgcm_c69m/mysetups/DINO_1deg/input_binaries/
MITgcm_c69m/mysetups/DINO_1deg/input_adj_binaries/

# ----------------------------------------------------------------------------
# analyses/ derived output
#
# These are regenerated by re-running the notebook that produced them, so they
# stay on disk but out of git. Together they are ~376 MB, which is most of what
# made this directory too big to push. See analyses/README.md.
# ----------------------------------------------------------------------------

# Animation exports: the standalone to_jshtml/GIF renderings (~286 MB)
analyses/**/*.html
analyses/**/*.gif

# Frame sequences assembled into the GIFs above (~90 MB, 920 files)
analyses/DINO_analyses/01_forward_analysis/moc_anim/
analyses/DINO_analyses/01_forward_analysis/moc_anim_jpg/
analyses/DINO_analyses/01_forward_analysis/moc_anim_jpg_std2/
analyses/DINO_analyses/02_adjoint_analysis/adj_theta_z14/
analyses/DINO_analyses/02_adjoint_analysis/adj_diffkr_z14/
analyses/DINO_analyses/02_adjoint_analysis/poster_frames/

# Editor autosave / scratch copies (.~poster.ipynb was a corrupt 155 MB one)
analyses/**/.~*
analyses/**/*-checkpoint.ipynb
